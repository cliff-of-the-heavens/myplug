# Neon connection string (Vercel's Neon integration sets this for you)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Random string of at least 32 chars, used to sign session cookies
SESSION_SECRET="change-me-to-a-long-random-string"

# Vercel Blob token for image uploads (Vercel > Storage > Blob).
# If unset in local dev, uploads are written to public/uploads instead.
BLOB_READ_WRITE_TOKEN=""

# How many distinct user reports auto-hide an image until an admin reviews it
REPORT_AUTO_HIDE_THRESHOLD=3

# Email alerts (https://resend.com). Without RESEND_API_KEY, alert emails are only logged.
RESEND_API_KEY=""
EMAIL_FROM="MyPlug <alerts@your-domain.com>"
# Public URL used for links in emails, e.g. https://myplug.vercel.app
APP_URL=""
# Protects /api/cron/alerts; Vercel Cron sends it automatically when set in the project
CRON_SECRET=""
